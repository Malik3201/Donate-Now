# Application URL (optional)
# Leave empty to auto-detect from the current request (recommended for most hosts).
# Set only when you need a fixed canonical URL, e.g. https://example.com or https://example.com/donate
APP_URL=

# Set to true to always use APP_URL from .env even when it differs from the current host
FORCE_APP_URL=false

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=donate_now
DB_USER=root
DB_PASS=

# Mail (Brevo SMTP)
# BREVO_SMTP_HOST=
# BREVO_SMTP_PORT=
# BREVO_SMTP_USER=
# BREVO_SMTP_PASS=
# BREVO_FROM_EMAIL=
# BREVO_FROM_NAME=Donate Now

# ImageKit (optional)
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
# IMAGEKIT_URL_ENDPOINT=

# Optional absolute logo URL for emails (must be public HTTPS)
# EMAIL_LOGO_URL=
