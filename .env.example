# Application URL (optional)
# Leave empty to auto-detect from the current request (recommended for most hosts).
# Set only when you need a fixed canonical URL, e.g. https://example.com or https://example.com/donate
APP_URL=

# Set to true to always use APP_URL from .env even when it differs from the current host
FORCE_APP_URL=false

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=donate_now
DB_USER=root
DB_PASS=

# Mail (Brevo) — API preferred on live hosting; SMTP as fallback
# BREVO_API_KEY=          # xkeysib-… (Transactional API — works over HTTPS when SMTP ports are blocked)
# BREVO_FROM_EMAIL=       # Verified sender in Brevo
# BREVO_FROM_NAME=Donate Now
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587     # 587/2525 STARTTLS, 465 SSL
# BREVO_SMTP_USER=
# BREVO_SMTP_PASS=        # xsmtpsib-… (SMTP key — not the API key)
# ADMIN_EMAIL=            # Admin alert inbox(es), comma-separated

# ImageKit (optional)
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
# IMAGEKIT_URL_ENDPOINT=

# Optional absolute logo URL for emails (must be public HTTPS)
# EMAIL_LOGO_URL=
